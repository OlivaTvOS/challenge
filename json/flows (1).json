                "c8a637e7cbac2f7b"
            ]
        ]
    },
    {
        "id": "696c43e4f6fc503a",
        "type": "function",
        "z": "37170caf977938a6",
        "name": "Processar Resposta Watson",
        "func": "// Extrair resposta do Watson baseado na nossa nova estrutura\nlet response_text = \"\";\n\nif (msg.payload.result && msg.payload.result.output && msg.payload.result.output.generic) {\n    const generics = msg.payload.result.output.generic;\n    for (let i = 0; i < generics.length; i++) {\n        if (generics[i].response_type === 'text' && generics[i].text) {\n            response_text += generics[i].text + \"\\n\\n\";\n        }\n    }\n}\n\n// Armazenar contexto para próxima interação se necessário\nif (msg.payload.result && msg.payload.result.context) {\n    msg.context = msg.payload.result.context;\n}\n\n// Preparar payload de volta para o Telegram (Exige 'content')\nmsg.payload = {\n    chatId: msg.payload.chatId || (msg.originalMessage ? msg.originalMessage.chat.id : null),\n    type: msg.payload.type || \"message\",\n    content: response_text.trim() || \"Desculpe, não consegui processar sua mensagem.\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 380,
        "wires": [
            [
                "05b5d80b2f1b4938"
            ]
        ]
    },
