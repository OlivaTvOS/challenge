    {
        "id": "e52589a769cb2d07",
        "type": "function",
        "z": "37170caf977938a6",
        "name": "Extrair Texto do Áudio",
        "func": "// Extrair o texto transcrito do response do STT\nif (msg.payload.result && msg.payload.result.results && msg.payload.result.results[0]) {\n    msg.payload.content = msg.payload.result.results[0].alternatives[0].transcript;\n} else {\n    msg.payload.content = \"Desculpe, não consegui compreender o áudio.\";\n}\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
